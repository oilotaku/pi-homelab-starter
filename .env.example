# 複製這個檔案為 .env 後依需求修改:
#   cp .env.example .env
# .env 已被 .gitignore 排除,不會被推上 GitHub。

TZ=Asia/Taipei

# ---- Pi-hole ----
# Web 管理介面登入密碼,務必修改,不要用預設值
PIHOLE_WEBPASSWORD=changeme
# 上游 DNS,分號分隔
PIHOLE_DNS_UPSTREAM=8.8.8.8;1.1.1.1

# ---- Samba ----
# 分享區塊的名稱(Windows/Mac 上看到的資料夾名稱)
SMB_SHARE_NAME=shared
# 要分享出去的實體路徑,必須已存在
SMB_SHARE_PATH=/mnt/mydata
# 允許存取此分享的系統使用者(腳本會確認/建立此使用者並設定 Samba 密碼)
SMB_USER=pi
SMB_WORKGROUP=WORKGROUP

# ---- Tailscale ----
# 留空則安裝後需自行 `sudo tailscale up` 手動登入
TS_AUTHKEY=
# true/false,是否把這台機器設為 exit node
TS_ADVERTISE_EXIT_NODE=false
# 要廣播的子網路由,逗號分隔,例如 192.168.1.0/24;留空則不廣播
TS_ADVERTISE_ROUTES=
# true/false,是否接受 Tailscale 提供的 DNS 設定
TS_ACCEPT_DNS=true
