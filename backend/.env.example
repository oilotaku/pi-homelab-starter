# 複製成 .env(已在 .gitignore,不會進版控),依你的機器填值。

# 監聽 port
PORT=8091

# 必填。用來驗證容器啟停/重啟、音量調整這類 mutating API 的 token。
# 產生範例: openssl rand -hex 24
AUTH_TOKEN=

# 允許被控制/列出的容器名稱,逗號分隔。留空 = 不限制(列出/可控所有容器)。
ALLOWED_CONTAINERS=dashboard,expense-tracker-web-frontend-1,expense-tracker-web-backend-1,expense-tracker-web-db-1,expense-tracker-web-redis-1

# CORS 允許的來源,留空或 * = 不限制(LAN-only 服務,mutating API 已用 token 保護)
CORS_ORIGIN=*
